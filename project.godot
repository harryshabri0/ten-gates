; Ten Gates - Godot 4 project configuration
; P0: Android landscape bootstrap. Gameplay is intentionally not included yet.
config_version=5

[application]

config/name="Ten Gates"
config/version="1.0.0"
config/icon="res://assets/release/ten_gates_icon.png"
run/main_scene="res://scenes/game/game_root.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.035, 0.055, 0.09, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/release/ten_gates_icon.png"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
Settings="*res://scripts/core/settings.gd"
SaveManager="*res://scripts/core/save_manager.gd"
UpdateService="*res://scripts/core/update_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[display/window]

size/resizable=true
handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

